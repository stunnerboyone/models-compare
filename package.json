{
  "name": "llm-data",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "snapshot": "node src/snapshot.js",
    "dry-run": "node src/snapshot.js --dry-run",
    "preview": "node src/preview.js",
    "report": "node src/report.js",
    "vendors": "node src/vendors.js",
    "check": "node src/vendors.js --check",
    "watch": "node src/watch.js",
    "webflow": "node --env-file-if-exists=.env src/webflow-inspect.js",
    "sync": "node --env-file-if-exists=.env src/webflow-sync.js",
    "sync:dry": "node --env-file-if-exists=.env src/webflow-sync.js --dry-run",
    "seed": "node --env-file-if-exists=.env src/webflow-seed.js",
    "seed:dry": "node --env-file-if-exists=.env src/webflow-seed.js --dry-run"
  }
}
